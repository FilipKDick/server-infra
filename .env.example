# Public base domain, without https:// prefix.
DOMAIN=yourdomain.com

# Umami analytics database.
UMAMI_POSTGRES_DB=umami
UMAMI_POSTGRES_USER=umami
UMAMI_POSTGRES_PASSWORD=CHANGE_ME

# Random string used by Umami to sign JWTs. Generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
UMAMI_APP_SECRET=CHANGE_ME

# Public URL used by Beszel links and redirects.
BESZEL_APP_URL=https://monitoring.yourdomain.com

# Fill these after creating the first system in the Beszel UI.
BESZEL_AGENT_TOKEN=CHANGE_ME
BESZEL_AGENT_KEY=CHANGE_ME
